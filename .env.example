# Supabase Configuration for ShrIEEEk '26
# Obtain these from your Supabase Project Settings -> API (https://supabase.com/dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin password for the /admin panel (change this to something secure!)
ADMIN_PASSWORD=change-me-to-a-secure-passphrase

# JWT Secret for session tokens (generate a random 32+ char string)
JWT_SECRET=generate-a-random-secret-here
